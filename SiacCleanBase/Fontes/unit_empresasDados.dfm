  object qry_DeleteTriggers: TOraQuery
    Session = DmModule.orsConexao
    SQL.Strings = (
      'SELECT '#39'ALTER TRIGGER '#39' || OBJECT_NAME || '#39' DISABLE ;'#39' as SCRIPT'
      '  FROM USER_OBJECTS C  '
      ' WHERE C.OBJECT_TYPE = '#39'TRIGGER'#39
      '--   AND C.OBJECT_NAME = '#39'PARAMETROS1_AUD_JN'#39
      ''
      'UNION ALL'
