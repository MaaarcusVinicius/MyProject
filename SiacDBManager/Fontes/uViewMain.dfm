  object OraScriptCriarUsuario: TOraScript
    SQL.Strings = (
      '-- Create the user '
      'create user :vUsuario'
      '  default tablespace DADOS'
      '  temporary tablespace TEMPO'
      '  profile DEFAULT;'
      '-- Grant/Revoke role privileges '
      'grant adm_parallel_execute_task to :vUsuario;'
      'grant aq_administrator_role to :vUsuario;'
      'grant aq_user_role to :vUsuario;'
      'grant authenticateduser to :vUsuario;'
      'grant connect to :vUsuario;'
      'grant ctxapp to :vUsuario;'
      'grant datapump_exp_full_database to :vUsuario;'
      'grant datapump_imp_full_database to :vUsuario;'
      'grant dba to :vUsuario;'
      'grant dbfs_role to :vUsuario;'
      'grant ejbclient to :vUsuario;'
      'grant execute_catalog_role to :vUsuario;'
      'grant exp_full_database to :vUsuario;'
      'grant gather_system_statistics to :vUsuario;'
      'grant hs_admin_execute_role to :vUsuario;'
      'grant hs_admin_role to :vUsuario;'
      'grant hs_admin_select_role to :vUsuario;'
      'grant imp_full_database to :vUsuario;'
      'grant javadebugpriv to :vUsuario;'
      'grant javaidpriv to :vUsuario;'
      'grant javasyspriv to :vUsuario;'
      'grant javauserpriv to :vUsuario;'
      'grant java_admin to :vUsuario;'
      'grant jmxserver to :vUsuario;'
      'grant logstdby_administrator to :vUsuario;'
      'grant oem_advisor to :vUsuario;'
      'grant oem_monitor to :vUsuario;'
      'grant olap_dba to :vUsuario;'
      'grant olap_user to :vUsuario;'
      'grant olap_xs_admin to :vUsuario;'
      'grant ordadmin to :vUsuario;'
      'grant recovery_catalog_owner to :vUsuario;'
      'grant resource to :vUsuario;'
      'grant scheduler_admin to :vUsuario;'
      'grant select_catalog_role to :vUsuario;'
      'grant wm_admin_role to :vUsuario;'
      'grant xdbadmin to :vUsuario;'
